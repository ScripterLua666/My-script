local AntiAfkActive = false
local AntiAfkConnection = nil

-- Позиция для клика — где нет UI (правый нижний угол)
-- Если у тебя там что-то есть — поменяй на (200, 200) или (300, 300)
local CLICK_POSITION = Vector2.new(10, 10)

local function DoAntiAfkClick()
    -- Способ 1: VirtualUser (фейковый клик)
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(CLICK_POSITION)
    end)

    -- Способ 2: VirtualInputManager (реальный клик по координатам)
    pcall(function()
        -- Движение мыши в точку
        VirtualInputManager:SendMouseMoveEvent(CLICK_POSITION.X, CLICK_POSITION.Y, false)
        task.wait(0.05)
        -- Нажатие ЛКМ
        VirtualInputManager:SendMouseButtonEvent(CLICK_POSITION.X, CLICK_POSITION.Y, 0, true, game, 0)
        task.wait(0.05)
        -- Отпускание ЛКМ
        VirtualInputManager:SendMouseButtonEvent(CLICK_POSITION.X, CLICK_POSITION.Y, 0, false, game, 0)
    end)
end

local function StartAntiAfk()
    if AntiAfkActive then return end
    AntiAfkActive = true

    -- 1) Ловим Idled — главный хук Roblox
    AntiAfkConnection = LocalPlayer.Idled:Connect(function()
        if not AntiAfkActive then return end
        DoAntiAfkClick()
    end)

    -- 2) Периодически кликаем сами (каждые 50 сек)
    task.spawn(function()
        while AntiAfkActive do
            task.wait(50)
            if not AntiAfkActive then break end
            DoAntiAfkClick()
        end
    end)
end

local function StopAntiAfk()
    AntiAfkActive = false
    if AntiAfkConnection then
        AntiAfkConnection:Disconnect()
        AntiAfkConnection = nil
    end
end

