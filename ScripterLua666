local function RunLoadingScreen()
    TweenService:Create(Backdrop, TweenInfo.new(0.4), {BackgroundTransparency = 0.4}):Play()
    TweenService:Create(LoadFrame, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()
    TweenService:Create(LFStroke, TweenInfo.new(0.4), {Transparency = 0}):Play()
    TweenService:Create(LoadTitle, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(LoadPercent, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
    TweenService:Create(BarBg, TweenInfo.new(0.4), {BackgroundTransparency = 0}):Play()

    task.wait(0.4)

    local DURATION = 5
    local startTime = tick()

    while tick() - startTime < DURATION do
        local elapsed = tick() - startTime
        local progress = math.clamp(elapsed / DURATION, 0, 1)

        BarFill.Size = UDim2.new(progress, 0, 1, 0)
        LoadPercent.Text = math.floor(progress * 100) .. "%"

        task.wait(0.02)
    end

    BarFill.Size = UDim2.new(1, 0, 1, 0)
    LoadPercent.Text = "100%"

    task.wait(0.4)

    TweenService:Create(Backdrop, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(LoadFrame, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    TweenService:Create(LFStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
    TweenService:Create(LoadTitle, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(LoadPercent, TweenInfo.new(0.5), {TextTransparency = 1}):Play()
    TweenService:Create(BarBg, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()

    task.wait(0.6)
    LoadingGui:Destroy()
end

