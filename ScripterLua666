local InstantPromptsActive = false
local PromptConnections = {}
local DescendantConn = nil

local function MakePromptInstant(prompt)
    if not prompt:IsA("ProximityPrompt") then return end
    if PromptConnections[prompt] then return end

    PromptConnections[prompt] = {
        HoldDuration        = prompt.HoldDuration,
        RequiresLineOfSight = prompt.RequiresLineOfSight,
        Enabled             = prompt.Enabled,
        ClickablePrompt     = prompt.ClickablePrompt,
        Style               = prompt.Style,
    }

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Enabled = true
        prompt.ClickablePrompt = true
        prompt.Style = Enum.ProximityPromptStyle.Custom
    end)
end

local function RestorePrompt(prompt)
    local d = PromptConnections[prompt]
    if not d then return end
    pcall(function()
        if prompt.Parent then
            prompt.HoldDuration = d.HoldDuration
            prompt.RequiresLineOfSight = d.RequiresLineOfSight
            prompt.Enabled = d.Enabled
            prompt.ClickablePrompt = d.ClickablePrompt
            prompt.Style = d.Style
        end
    end)
    PromptConnections[prompt] = nil
end

local function ScanPrompts()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then MakePromptInstant(obj) end
    end
end

local function StartInstantPrompts()
    if InstantPromptsActive then return end
    InstantPromptsActive = true
    ScanPrompts()
    DescendantConn = workspace.DescendantAdded:Connect(function(obj)
        if not InstantPromptsActive then return end
        if obj:IsA("ProximityPrompt") then
            task.wait(0.05)
            if obj and obj.Parent then MakePromptInstant(obj) end
        end
    end)
end

local function StopInstantPrompts()
    InstantPromptsActive = false
    if DescendantConn then
        DescendantConn:Disconnect()
        DescendantConn = nil
    end
    for prompt, _ in pairs(PromptConnections) do RestorePrompt(prompt) end
end

-- ================================================================
--      ХОДЬБА через BodyVelocity
-- ================================================================

local function FastWalkToPosition(targetPos, speed, timeoutSec, stopCheck)
    speed = speed or 100
    timeoutSec = timeoutSec or 30

    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local oldBV = hrp:FindFirstChild("BaconHubSpeed")
    if oldBV then oldBV:Destroy() end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "BaconHubSpeed"
    bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
    bv.Velocity = Vector3.zero
    bv.P = 1250
    bv.Parent = hrp

    local startTime = tick()
    local lastMoveTo = 0
    local ARRIVE_DISTANCE = 4
    local SLOWDOWN_DISTANCE = 20

    while tick() - startTime < timeoutSec do
        if stopCheck and stopCheck() then
            bv.Velocity = Vector3.zero
            task.wait(0.05)
            bv:Destroy()
            return false
        end

        local c = LocalPlayer.Character
        if not c then bv:Destroy() return false end
        local h = c:FindFirstChild("HumanoidRootPart")
        if not h then bv:Destroy() return false end
        if hum.Health <= 0 then bv:Destroy() return false end

        local diff = targetPos - h.Position
        local dist = diff.Magnitude

        if dist <= ARRIVE_DISTANCE then
            bv.Velocity = Vector3.zero
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.03)
            h.CFrame = CFrame.new(targetPos)
            h.AssemblyLinearVelocity = Vector3.zero
            bv:Destroy()
            return true
        end

        local dir = Vector3.new(diff.X, 0, diff.Z).Unit
        local finalSpeed = speed

        if dist < SLOWDOWN_DISTANCE then
            local t = (dist - ARRIVE_DISTANCE) / (SLOWDOWN_DISTANCE - ARRIVE_DISTANCE)
            t = math.clamp(t, 0, 1)
            finalSpeed = speed * t
        end

        bv.Velocity = dir * finalSpeed

        if tick() - lastMoveTo > 0.3 then
            hum:MoveTo(targetPos)
            lastMoveTo = tick()
        end

        task.wait(0.05)
    end

    bv.Velocity = Vector3.zero
    task.wait(0.05)
    bv:Destroy()
    return false
end

-- ================================================================
--                        SPEED FARM
-- ================================================================

local SpeedFarmActive = false
local SpeedFarmOnTreadmill = false
local SPEED_FARM_SPEED = 200

local function GetTreadmillEvent()
    local ok, result = pcall(function()
        return ReplicatedStorage.Packages.Networking["RF/Treadmill/AskWearStill"]
    end)
    if ok and result then return result end
    return nil
end

local function StartSpeedFarm()
    if SpeedFarmActive then return end
    if not SavedTreadmillPosition then
        warn("[SpeedFarm] Позиция не сохранена")
        return false
    end
    SpeedFarmActive = true
    SpeedFarmOnTreadmill = false

    task.spawn(function()
        local arrived = FastWalkToPosition(SavedTreadmillPosition, SPEED_FARM_SPEED, 30, function()
            return not SpeedFarmActive
        end)

        if not SpeedFarmActive then return end

        if arrived then
            local event = GetTreadmillEvent()
            if event then
                local ok = pcall(function() event:InvokeServer() end)
                if ok then
                    SpeedFarmOnTreadmill = true
                end
            else
                warn("[SpeedFarm] RF не найдено")
            end
        else
            warn("[SpeedFarm] Не дошёл за 30 сек")
        end
    end)

    return true
end

local function StopSpeedFarm()
    if not SpeedFarmActive then return end
    SpeedFarmActive = false
    SpeedFarmOnTreadmill = false

    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("BaconHubSpeed")
            if bv then
                bv.Velocity = Vector3.zero
                task.wait(0.05)
                bv:Destroy()
            end
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    pcall(function()
        local Packages = ReplicatedStorage:FindFirstChild("Packages")
        if Packages then
            local Networking = Packages:FindFirstChild("Networking")
            if Networking then
                for _, n in ipairs({
                    "RF/Treadmill/StopWearStill",
                    "RF/Treadmill/RemoveStill",
                    "RF/Treadmill/UnequipStill",
                    "RF/Treadmill/AskStop",
                    "RF/Treadmill/Stop",
                }) do
                    local ev = Networking:FindFirstChild(n)
                    if ev then pcall(function() ev:InvokeServer() end) end
                end
            end
        end
    end)
end

