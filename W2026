local function FindBatTool()
    local keywords = {"bat", "бита", "бит", "baseball", "stick", "палка", "club", "weapon", "flyswatter", "мухобойка"}

    local function checkTool(tool)
        if not tool:IsA("Tool") then return false end
        local n = tool.Name:lower()
        for _, kw in ipairs(keywords) do
            if n:find(kw) then return true end
        end
        return false
    end

    local char = LocalPlayer.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if checkTool(tool) then return tool end
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if checkTool(tool) then return tool end
        end
    end

    return nil
end

local function GetBatHitboxes(tool)
    local hitboxes = {}
    local seen = {}

    local function add(part)
        if seen[part] then return end
        seen[part] = true
        table.insert(hitboxes, part)
    end

    for _, v in ipairs(tool:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            if n:find("hitbox") or n:find("hit") or n:find("damage") or n:find("blade") then
                add(v)
            end
        end
    end

    local handle = tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then add(handle) end

    if #hitboxes == 0 then
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("BasePart") then add(v) end
        end
    end

    return hitboxes
end

local function GetPlayerHitboxes(character)
    local hitboxes = {}
    local seen = {}

    local function add(part)
        if seen[part] then return end
        if not part:IsA("BasePart") then return end
        seen[part] = true
        table.insert(hitboxes, part)
    end

    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            if n:find("hitbox") or n:find("hit") then
                add(v)
            end
        end
    end

    if #hitboxes > 0 then
        return hitboxes
    end

    local bodyParts = {
        "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso",
        "LeftArm", "RightArm", "LeftLeg", "RightLeg",
        "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
        "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
        "LeftFoot", "RightFoot", "LeftHand", "RightHand"
    }

    for _, name in ipairs(bodyParts) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then add(part) end
    end

    if #hitboxes == 0 then
        for _, v in ipairs(character:GetChildren()) do
            if v:IsA("BasePart") then add(v) end
        end
    end

    return hitboxes
end

local function TouchHitbox(batHb, targetHb)
    pcall(function() firetouchinterest(batHb, targetHb, 0) end)
    task.wait(0.02)
    pcall(function() firetouchinterest(batHb, targetHb, 1) end)
end

local function ForceTouchAll(targetHb)
    if not getconnections then return end
    local conns = getconnections(targetHb.Touched)
    if not conns then return end
    for _, conn in ipairs(conns) do
        if conn.Fire then
            pcall(function() conn:Fire(targetHb) end)
        end
    end
end

local function UseBatOnce()
    local tool = FindBatTool()
    if not tool then
        warn("[Use Bat] Bat не найден в Backpack/Character")
        return false
    end

    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    pcall(function() hum:EquipTool(tool) end)
    task.wait(0.15)

    local batHitboxes = GetBatHitboxes(tool)
    if #batHitboxes > 0 then
        pcall(function() tool:Activate() end)
        task.wait(0.05)

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local targetHitboxes = GetPlayerHitboxes(plr.Character)
                for _, batHb in ipairs(batHitboxes) do
                    for _, targetHb in ipairs(targetHitboxes) do
                        TouchHitbox(batHb, targetHb)
                        ForceTouchAll(targetHb)
                    end
                end
            end
        end
    end

    task.wait(0.05)

    pcall(function() hum:UnequipTools() end)
    task.wait(0.05)

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and tool and tool.Parent == char then
        pcall(function() tool.Parent = backpack end)
    end

    return true
end

